# Bloquear el acceso web a archivos de configuración y ocultos (.env, .git, .gitignore...)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Bloquear también el contenido de carpetas ocultas (.git/, .svn/...)
RedirectMatch 403 "(^|/)\.(git|svn|hg)(/|$)"

# No listar el contenido de las carpetas
Options -Indexes
