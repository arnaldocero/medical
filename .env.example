# ==========================================================
#  Plantilla de configuración. Copiar como ".env" y completar.
#  El archivo .env real NO se sube a git.
# ==========================================================

# Base de datos
DB_HOST=localhost
DB_NAME=nombre_base_datos
DB_USER=usuario_base_datos
# Use comillas simples si la contraseña tiene caracteres especiales
DB_PASS='cambiar_esta_clave'
DB_CHARSET=utf8mb4

# Aplicación
# URL pública sin barra final, ej: https://midominio.com/HMS (vacío = detección automática)
APP_URL=
MAIL_FROM=no-reply@midominio.com
MAIL_FROM_NAME="Medical Creations"
